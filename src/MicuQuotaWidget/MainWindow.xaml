<Window x:Class="MicuQuotaWidget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        Title="MicuQuotaWidget"
        Width="302"
        Height="184"
        MinWidth="286"
        MinHeight="172"
        MaxWidth="340"
        MaxHeight="210"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ShowInTaskbar="False"
        AllowsTransparency="False"
        Background="Transparent"
        Topmost="{Binding IsTopmost, Mode=TwoWay}">
    <Window.InputBindings>
        <KeyBinding Key="R" Modifiers="Control" Command="{Binding RefreshCommand}" />
        <KeyBinding Key="T" Modifiers="Control" Command="{Binding ToggleTopmostCommand}" />
    </Window.InputBindings>

    <Border Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="12"
            SnapsToDevicePixels="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="*" />
                <RowDefinition Height="44" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{StaticResource HeaderBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="12,12,0,0"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid Margin="14,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock VerticalAlignment="Center"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}"
                               Text="Micu 余额" />

                    <ToggleButton x:Name="TopmostToggle"
                                  Grid.Column="1"
                                  VerticalAlignment="Center"
                                  IsChecked="{Binding IsTopmost, Mode=TwoWay}"
                                  Content="{Binding TopmostText}"
                                  Style="{StaticResource CompactToggleStyle}"
                                  ToolTip="Ctrl+T 切换窗口置顶"
                                  automation:AutomationProperties.Name="切换窗口置顶" />

                    <Button x:Name="HideButton"
                            Grid.Column="3"
                            Width="28"
                            Height="28"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            Click="CloseButton_Click"
                            Cursor="Hand"
                            FocusVisualStyle="{StaticResource AccessibleFocusVisual}"
                            ToolTip="隐藏到通知区域"
                            automation:AutomationProperties.Name="隐藏到通知区域">
                        <Path Width="12"
                              Height="12"
                              Data="M 1,1 L 11,11 M 11,1 L 1,11"
                              Stroke="{StaticResource MutedTextBrush}"
                              StrokeEndLineCap="Round"
                              StrokeStartLineCap="Round"
                              StrokeThickness="1.8" />
                    </Button>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="16,12,16,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Foreground="{StaticResource MutedTextBrush}"
                           FontSize="12"
                           Text="当前可用余额" />
                <TextBlock Grid.Row="1"
                           Margin="0,3,0,4"
                           FontFamily="Cascadia Mono, Consolas"
                           FontSize="27"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}"
                           Text="{Binding BalanceText}"
                           TextTrimming="CharacterEllipsis" />
                <StackPanel Grid.Row="2" Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Margin="0,3,7,0" Fill="{StaticResource AccentBrush}" />
                    <TextBlock MaxWidth="226"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="12"
                               Text="{Binding StatusText}"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding DetailText}" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="2"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,1,0,0">
                <Grid Margin="12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock VerticalAlignment="Center"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="11"
                               Text="{Binding LastUpdatedText}"
                               TextTrimming="CharacterEllipsis" />
                    <Button x:Name="SettingsButton"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Content="设置"
                            Style="{StaticResource QuietButtonStyle}"
                            Click="SettingsButton_Click"
                            ToolTip="配置 Micu 查询方式和 API Key"
                            automation:AutomationProperties.Name="打开设置" />
                    <Button x:Name="RefreshButton"
                            Grid.Column="3"
                            VerticalAlignment="Center"
                            Command="{Binding RefreshCommand}"
                            Content="刷新"
                            Style="{StaticResource PrimaryButtonStyle}"
                            ToolTip="Ctrl+R 立即刷新余额"
                            automation:AutomationProperties.Name="立即刷新余额" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
