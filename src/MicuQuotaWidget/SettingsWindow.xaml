<Window x:Class="MicuQuotaWidget.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        Title="MicuQuotaWidget 设置"
        Width="432"
        Height="344"
        MinWidth="400"
        MinHeight="320"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource SurfaceBrush}">
    <Grid Margin="28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="10" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="18" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="10" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock FontSize="20"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextBrush}"
                       Text="Micu 查询设置" />
            <TextBlock Margin="0,5,0,0"
                       Foreground="{StaticResource MutedTextBrush}"
                       TextWrapping="Wrap"
                       Text="API Key 仅保存到当前 Windows 用户的 Credential Manager，不会写入项目文件。" />
        </StackPanel>

        <StackPanel Grid.Row="2">
            <TextBlock FontWeight="SemiBold" Text="查询方式" />
            <ComboBox x:Name="EndpointKindComboBox"
                      Margin="0,6,0,0"
                      Height="34"
                      SelectedIndex="0"
                      automation:AutomationProperties.Name="选择 Micu 查询方式">
                <ComboBoxItem Tag="MicuApi" Content="Micu API（推荐）" />
                <ComboBoxItem Tag="MicuSubscription" Content="Micu Subscription（旧订阅）" />
            </ComboBox>
            <TextBlock Margin="0,5,0,0"
                       Foreground="{StaticResource MutedTextBrush}"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Text="程序只会连接所选 Micu 官方 HTTPS 主机，不支持自定义地址。" />
        </StackPanel>

        <StackPanel Grid.Row="4">
            <TextBlock FontWeight="SemiBold" Text="API Key" />
            <PasswordBox x:Name="ApiKeyPasswordBox"
                         Margin="0,6,0,0"
                         Height="34"
                         Padding="10,6"
                         ToolTip="留空会保留现有 API Key"
                         automation:AutomationProperties.Name="Micu API Key" />
            <TextBlock Margin="0,5,0,0"
                       Foreground="{StaticResource MutedTextBrush}"
                       FontSize="12"
                       Text="首次配置必须输入 Key；后续留空即可保留现有 Key。" />
        </StackPanel>

        <TextBlock x:Name="ValidationTextBlock"
                   Grid.Row="6"
                   Foreground="{StaticResource MutedTextBrush}"
                   TextWrapping="Wrap"
                   automation:AutomationProperties.LiveSetting="Polite" />

        <StackPanel Grid.Row="8" HorizontalAlignment="Right" Orientation="Horizontal">
            <Button Margin="0,0,8,0"
                    Content="取消"
                    Style="{StaticResource QuietButtonStyle}"
                    Click="CancelButton_Click"
                    automation:AutomationProperties.Name="取消设置" />
            <Button Content="保存并刷新"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Click="SaveButton_Click"
                    automation:AutomationProperties.Name="保存 Micu 设置并刷新余额" />
        </StackPanel>
    </Grid>
</Window>
