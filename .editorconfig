root = true

[*.{cs,vb}]
charset = utf-8-bom
indent_style = space
indent_size = 4
end_of_line = crlf
insert_final_newline = true
dotnet_sort_system_directives_first = true
dotnet_style_qualification_for_field = false:suggestion
dotnet_diagnostic.IDE0055.severity = warning

[*.{xaml,xml,csproj,props,md,ps1}]
charset = utf-8-bom
indent_style = space
indent_size = 2
end_of_line = crlf
insert_final_newline = true
